# =============================================================================
# EFootball Tournament Platform — environment
#
# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Never put a secret
# behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Safe in the browser: every request it makes is
# constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Supabase — server only
# -----------------------------------------------------------------------------
# Service role key. Bypasses RLS completely. Server-side only; it is imported
# through a `server-only` module so a client component that touches it fails
# the build rather than leaking it.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Only needed to apply migrations/seed and
# to run the release-blocking concurrency test (npm run test:db).
SUPABASE_DB_URL=

# Project ref, used by `npm run db:types`.
SUPABASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# AI vision + reporter (Anthropic)
# -----------------------------------------------------------------------------
# Server-side only. Used for screenshot extraction and the sports reporter.
# Without it, evidence is still stored and matches park in manual review —
# a missing key never auto-approves a result.
AI_API_KEY=

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Bot token from @BotFather. Server-side only.
TELEGRAM_BOT_TOKEN=

# Bot username without the @, used to build the /start deep link.
TELEGRAM_BOT_USERNAME=

# Random string (32+ chars). Sent by Telegram as the
# X-Telegram-Bot-Api-Secret-Token header and compared in constant time.
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public origin, no trailing slash. Used for invite links, Telegram deep links
# and OpenGraph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the scheduled Telegram outbox drain (/api/telegram/retry).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Web Push (VAPID)
# -----------------------------------------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
# The public key identifies the sender to the push service and is safe in the
# browser. Without these, push is simply off: the in-app notification rows are
# still written, and the toggle says so rather than pretending to work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service uses to reach you about your sender.
VAPID_SUBJECT=mailto:you@example.com
